# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy
MIN_EDGE_THRESHOLD=0.05
MIN_EDGE_DOWN=0.08
MAX_EDGE_THRESHOLD=0.18
MAX_SIGNAL_VALUE=0.45
BET_SIZE_USDC=5
VIRTUAL_BANKROLL=100
USE_KELLY=false

# Polymarket Builder Mode (for live trading — leave blank for paper-only)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Polymarket fee curve (crypto markets defaults)
# fee = price * rate * (price * (1 - price))^exponent
# Peak fee at p=0.50: ~1.56%. Near-zero at extremes.
POLYMARKET_FEE_RATE=0.25
POLYMARKET_FEE_EXPONENT=2

# Data
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Confidence dampening — shrink model P(up) toward 50% (1.0=none, 0.0=always 50%)
CONFIDENCE_DAMPEN=0.6

# Hour blacklist — skip trading during these UTC hours (comma-separated)
BLACKLIST_HOURS=2

# Feature weights (v1)
W_OBI=0.25
W_TAKER=0.25
W_MOMENTUM=0.15
W_RSI=0.15
W_VWAP=0.10
W_FUNDING=0.10
