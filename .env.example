# =============================================================================
# BTC Polymarket 5-Minute Edge Finder — Configuration
# Copy to .env and fill in your values.
# =============================================================================

# -- Telegram --
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Strategy --
MIN_EDGE_THRESHOLD=0.05        # min positive edge for classic mode (ignored in always-trade)
MAX_EDGE_THRESHOLD=0.18        # cap — edges above this are rejected as model error
MAX_SIGNAL_VALUE=0.45          # skip when any single signal is saturated
BET_SIZE_USDC=5                # fixed bet size (used when SIZING_STRATEGY=fixed)
VIRTUAL_BANKROLL=100           # starting paper bankroll
USE_KELLY=false                # half-Kelly sizing (legacy, use SIZING_STRATEGY instead)

# -- ML Model --
USE_ML_MODEL=true              # true=ML model, false=rule-based ensemble
ALWAYS_TRADE=true              # true=trade every window, false=only on edge > threshold
MIN_CONFIDENCE=0.015           # min |P(up)-0.5| to trade (backtested sweet spot)
SIZING_STRATEGY=adaptive       # fixed | kelly | adaptive
CONFIDENCE_DAMPEN=1.0          # 1.0=no dampening (disabled 2026-03-04). 0.6=original.

# -- Live Trading (real money on Polymarket) --
LIVE_TRADING=false
POLYMARKET_PRIVATE_KEY=        # EOA private key (hex, no 0x prefix) from Rabby
POLYMARKET_FUNDER_ADDRESS=     # Proxy wallet from polymarket.com deposit settings
MAX_LIVE_BET_USDC=10.0         # Hard safety cap per trade
CLOB_PROXY=                    # SOCKS5 proxy if needed (e.g. socks5://127.0.0.1:1080)

# -- Polymarket Fees --
POLYMARKET_FEE_RATE=0.25
POLYMARKET_FEE_EXPONENT=2

# -- Adaptive Early Exit (tiered thresholds by entry price) --
EARLY_EXIT_THRESHOLD_LOW=0.50      # entry < 0.35: lottery tickets, exit on any spike
EARLY_EXIT_THRESHOLD_LOW_MID=0.65  # entry 0.35-0.40: raised from 0.45 on 2026-03-05
EARLY_EXIT_THRESHOLD_MID=0.90      # entry 0.40-0.50: raised from 0.65 on 2026-03-05
EARLY_EXIT_THRESHOLD_HIGH=0.95     # entry >= 0.50: conservative, let winners run

# -- Regime Detection & Flip --
REGIME_TREND_THRESHOLD=0.30        # strength threshold for trending classification
REGIME_FLIP_THRESHOLD=0.35         # flip to trend-following when |strength| >= this
REGIME_FLIP_LIVE=true              # enable regime flip for live trades
REGIME_FLIP_CONFIRM_WINDOWS=1      # consecutive trending windows before flip fires

# -- Loss Streak Guard --
STREAK_PAUSE_THRESHOLD=3           # consecutive same-side losses to trigger pause
STREAK_PAUSE_WINDOWS=2             # number of 5-min windows to pause (~10 min)

# -- Hour Blacklist --
BLACKLIST_HOURS=2                  # comma-separated UTC hours to skip, e.g. "2,3,4"

# -- Live Entry Range (EE sweet spot — data-backed) --
LIVE_ENTRY_MIN=0.40               # lower bound for live trades (paper below)
LIVE_ENTRY_MAX=0.50               # upper bound for live trades (paper above)

# -- Data URLs --
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# -- Feature Weights (rule-based fallback only) --
W_OBI=0.05
W_TAKER=0.25
W_MOMENTUM=0.05
W_RSI=0.10
W_VWAP=0.10
W_FUNDING=0.10
W_VOLUME_ZSCORE=0.15
W_REGIME=0.20
